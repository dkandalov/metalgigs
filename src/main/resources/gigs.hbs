<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>London Metal Gigs</title>
    <style>
        :root {
            color-scheme: dark;
        }
        body {
            margin: 0;
            padding: 2rem 1.5rem 4rem;
            background: #0d0d0f;
            color: #e6e6e6;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        main {
            max-width: 1100px;
            margin: 0 auto;
        }
        h1 {
            font-size: 2rem;
            margin-bottom: 2rem;
        }
        h2 {
            font-size: 1.1rem;
            color: #9a9a9a;
            font-weight: 600;
            border-bottom: 1px solid #26262a;
            padding-bottom: 0.5rem;
            margin: 2.5rem 0 1rem;
        }
        .gigs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 1.25rem;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .gig-card {
            background: #18181b;
            border: 1px solid #26262a;
            border-radius: 10px;
            overflow: hidden;
        }
        .gig-image {
            display: block;
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            background: #26262a;
        }
        .gig-info {
            padding: 0.85rem 1rem 1rem;
        }
        .gig-card a {
            display: block;
            margin-bottom: 0.4rem;
            color: #f2f2f2;
            font-weight: 600;
            text-decoration: none;
        }
        .gig-card a:hover {
            text-decoration: underline;
        }
        .gig-venue {
            color: #a1a1aa;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
<main>
    <h1>London Metal Gigs</h1>
    {{#each dateGroups}}
    <h2>{{date}}</h2>
    <ul class="gigs-grid">
        {{#each gigs}}
        <li class="gig-card">
            <a href="{{url}}"><img class="gig-image" src="{{imageUrl}}" alt="{{title}}" loading="lazy"></a>
            <div class="gig-info">
                <a href="{{url}}">{{title}}</a>
                <div class="gig-venue">{{venue}}</div>
            </div>
        </li>
        {{/each}}
    </ul>
    {{/each}}
</main>
</body>
</html>
