<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>London Metal Gigs</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.classless.min.css">
</head>
<body>
<main>
    <h1>London Metal Gigs</h1>
    {{#each dateGroups}}
    <h2>{{date}}</h2>
    <ul>
        {{#each gigs}}
        <li><strong>{{venue}}</strong>: <a href="{{url}}">{{title}}</a></li>
        {{/each}}
    </ul>
    {{/each}}
</main>
</body>
</html>
