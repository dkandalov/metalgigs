<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>London Metal Gigs - upcoming metal and hardcore shows in London</title>
    <meta name="description" content="Upcoming metal, hardcore and heavy gigs in London, listed by date and updated daily. Covering the Underworld, the Black Heart, the Dev, Helgi's and more.">
    <link rel="canonical" href="https://metalgigs.london/">
    <meta name="theme-color" content="#0d0d0f">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="London Metal Gigs">
    <meta property="og:title" content="London Metal Gigs">
    <meta property="og:description" content="Upcoming metal, hardcore and heavy gigs in London, listed by date and updated daily. Covering the Underworld, the Black Heart, the Dev, Helgi's and more.">
    <meta property="og:url" content="https://metalgigs.london/">
    <meta property="og:image" content="https://metalgigs.london/apple-touch-icon.png">
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <link rel="icon" href="favicon.ico" sizes="48x48 32x32 16x16">
    <link rel="apple-touch-icon" href="apple-touch-icon.png">
    <style>
        :root {
            color-scheme: dark;
        }
        body {
            margin: 0;
            padding: 2rem 1.5rem 4rem;
            background: #0d0d0f;
            color: #e6e6e6;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        main {
            max-width: 1100px;
            margin: 0 auto;
        }
        .page-header {
            display: flex;
            /* on a narrow screen the search drops onto its own line rather than squeezing the title */
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem 1.5rem;
            margin-bottom: 2rem;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 0.7rem;
        }
        .brand-mark {
            display: block;
            flex: none;
            width: 2.4rem;
            height: 2.4rem;
            border-radius: 9px;
        }
        h1 {
            font-size: 2rem;
            line-height: 1;
            margin: 0;
        }
        h2 {
            font-size: 1.1rem;
            color: #9a9a9a;
            font-weight: 600;
            border-bottom: 1px solid #26262a;
            padding-bottom: 0.5rem;
            margin: 2.5rem 0 1rem;
        }
        .gig-search {
            box-sizing: border-box;
            /* grows into whatever the title leaves, up to a width that keeps it a control in the
               header rather than a second banner across it */
            flex: 1 1 12rem;
            max-width: 16rem;
            padding: 0.4rem 0.8rem;
            background: #18181b;
            border: 1px solid #26262a;
            border-radius: 999px;
            color: #e6e6e6;
            font: inherit;
            font-size: 0.9rem;
        }
        .gig-search:focus-visible {
            outline: 2px solid #f2f2f2;
            outline-offset: 2px;
        }
        .no-matches {
            margin-top: 0;
            color: #a1a1aa;
        }
        .gigs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 1.25rem;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .gig-card {
            background: #18181b;
            border: 1px solid #26262a;
            border-radius: 10px;
            overflow: hidden;
        }
        .gig-image {
            display: block;
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            background: #26262a;
        }
        .gig-card a {
            display: block;
            position: relative;
            color: inherit;
            text-decoration: none;
        }
        .gig-card a:hover .gig-title {
            text-decoration: underline;
        }
        /* Two-tone, because the link wraps the poster and one colour is only guaranteed to show
           against some artwork. Drawn as an overlay rather than as the link's own outline and inset
           shadow: an inset shadow paints below child content, so the dark half of the ring would sit
           behind the very image it exists to stand out against. Inside the card rather than around
           it, because .gig-card clips whatever leaves its rounded box. The transparent outline is
           what leaves a focus ring in forced-colors mode, where shadows aren't painted at all. */
        .gig-card a:focus-visible {
            outline: 2px solid transparent;
            outline-offset: -6px;
        }
        .gig-card a:focus-visible::after {
            content: "";
            position: absolute;
            inset: 0;
            /* the card's 10px, less the 1px border this sits inside */
            border-radius: 9px;
            box-shadow: inset 0 0 0 4px #0d0d0f, inset 0 0 0 6px #f2f2f2;
        }
        /* Spans rather than divs so one link can wrap the whole card without nesting block-level
           content in it, so they need laying out as blocks explicitly. */
        .gig-info {
            display: block;
            padding: 0.85rem 1rem 1rem;
        }
        .gig-title {
            display: block;
            margin-bottom: 0.4rem;
            color: #f2f2f2;
            font-weight: 600;
        }
        .gig-venue {
            display: block;
            color: #a1a1aa;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
<main>
    <header class="page-header">
        <div class="brand">
            <!-- favicon.svg's bolt with its colours swapped, so the tile reads as a mark against the
                 page rather than disappearing into it. Inline to save a request and because it's the
                 second copy of that artwork - change one and the other wants changing too.
                 aria-hidden because the heading beside it already says the name. -->
            <svg class="brand-mark" viewBox="0 0 512 512" aria-hidden="true">
                <rect width="512" height="512" fill="#e6e6e6"/>
                <polygon points="310,50 140,290 240,290 190,462 385,215 275,215" fill="#0d0d0f"/>
            </svg>
            <h1>London Metal Gigs</h1>
        </div>
    </header>
    
    <section class="date-group">
    <h2>Saturday, 8 August 2026</h2>
    <ul class="gigs-grid">
        
        <li class="gig-card">
            <a href="https://example.com/gigs/early-gig-one">
                <img class="gig-image" src="images/2026-08-08-venue-a-e8f74dd6.webp" alt="" loading="lazy">
                <span class="gig-info">
                    <span class="gig-title">Early Gig One</span>
                    <span class="gig-venue">Venue A</span>
                </span>
            </a>
        </li>
        
        <li class="gig-card">
            <a href="https://example.com/gigs/early-gig-two">
                <img class="gig-image" src="images/2026-08-08-venue-b-40b1a885.webp" alt="" loading="lazy">
                <span class="gig-info">
                    <span class="gig-title">Early Gig Two</span>
                    <span class="gig-venue">Venue B</span>
                </span>
            </a>
        </li>
        
    </ul>
    </section>
    
    <section class="date-group">
    <h2>Tuesday, 1 September 2026</h2>
    <ul class="gigs-grid">
        
        <li class="gig-card">
            <a href="https://example.com/gigs/late-gig">
                <img class="gig-image" src="images/2026-09-01-venue-a-1c8f1c82.webp" alt="" loading="lazy">
                <span class="gig-info">
                    <span class="gig-title">Late Gig</span>
                    <span class="gig-venue">Venue A</span>
                </span>
            </a>
        </li>
        
    </ul>
    </section>
    
</main>
<script>
    // The search box is built here rather than sitting in the template so that it only ever appears
    // when there is script to run it - the page is otherwise entirely static, and a box that
    // silently does nothing is worse than no box.
    (() => {
        const cards = [...document.querySelectorAll('.gig-card')]
            // both the title and the venue are inside the card, so its own text is the whole
            // haystack; lowercased once here rather than on every keystroke
            .map(card => ({card, text: card.textContent.toLowerCase()}))
        const dateGroups = [...document.querySelectorAll('.date-group')]
        if (!cards.length) return

        const search = document.createElement('input')
        search.type = 'search'
        search.className = 'gig-search'
        search.placeholder = 'Search gigs and venues'
        search.autocomplete = 'off'
        search.setAttribute('aria-label', 'Search gigs and venues')

        // role=status so that emptying the page is announced rather than only shown
        const noMatches = document.createElement('p')
        noMatches.className = 'no-matches'
        noMatches.setAttribute('role', 'status')
        noMatches.textContent = 'No gigs match that search.'
        noMatches.hidden = true

        const header = document.querySelector('.page-header')
        header.append(search)
        header.after(noMatches)

        search.addEventListener('input', () => {
            const query = search.value.trim().toLowerCase()
            for (const {card, text} of cards) card.hidden = query !== '' && !text.includes(query)
            // a date whose gigs are all filtered out goes too, or the page fills with headings
            // standing over nothing
            for (const group of dateGroups) group.hidden = !group.querySelector('.gig-card:not([hidden])')
            noMatches.hidden = query === '' || dateGroups.some(group => !group.hidden)
        })
    })()
</script>
</body>
</html>
