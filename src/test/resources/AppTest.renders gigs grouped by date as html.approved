<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>London Metal Gigs</title>
    <style>
        :root {
            color-scheme: dark;
        }
        body {
            margin: 0;
            padding: 2rem 1.5rem 4rem;
            background: #0d0d0f;
            color: #e6e6e6;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        main {
            max-width: 1100px;
            margin: 0 auto;
        }
        h1 {
            font-size: 2rem;
            margin-bottom: 2rem;
        }
        h2 {
            font-size: 1.1rem;
            color: #9a9a9a;
            font-weight: 600;
            border-bottom: 1px solid #26262a;
            padding-bottom: 0.5rem;
            margin: 2.5rem 0 1rem;
        }
        .gigs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 1.25rem;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .gig-card {
            background: #18181b;
            border: 1px solid #26262a;
            border-radius: 10px;
            overflow: hidden;
        }
        .gig-image {
            display: block;
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            background: #26262a;
        }
        .gig-info {
            padding: 0.85rem 1rem 1rem;
        }
        .gig-card a {
            display: block;
            margin-bottom: 0.4rem;
            color: #f2f2f2;
            font-weight: 600;
            text-decoration: none;
        }
        .gig-card a:hover {
            text-decoration: underline;
        }
        .gig-venue {
            color: #a1a1aa;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
<main>
    <h1>London Metal Gigs</h1>
    
    <h2>Saturday, 8 August 2026</h2>
    <ul class="gigs-grid">
        
        <li class="gig-card">
            <a href="https://example.com/gigs/early-gig-one"><img class="gig-image" src="images/e8f74dd64c2e4320d49d803d62d878fb52a695939482e8cb93d690358f37b793.jpg" alt="Early Gig One" loading="lazy"></a>
            <div class="gig-info">
                <a href="https://example.com/gigs/early-gig-one">Early Gig One</a>
                <div class="gig-venue">Venue A</div>
            </div>
        </li>
        
        <li class="gig-card">
            <a href="https://example.com/gigs/early-gig-two"><img class="gig-image" src="images/40b1a885f648ddee0e33d5eac27835297c70ca118d08b14a2a5dd0bd6fae2c8f.jpg" alt="Early Gig Two" loading="lazy"></a>
            <div class="gig-info">
                <a href="https://example.com/gigs/early-gig-two">Early Gig Two</a>
                <div class="gig-venue">Venue B</div>
            </div>
        </li>
        
    </ul>
    
    <h2>Tuesday, 1 September 2026</h2>
    <ul class="gigs-grid">
        
        <li class="gig-card">
            <a href="https://example.com/gigs/late-gig"><img class="gig-image" src="images/1c8f1c8297019b2b5d59b3a2eefba84098b99844b8eede1ba546fc9e2b3d1eb8.jpg" alt="Late Gig" loading="lazy"></a>
            <div class="gig-info">
                <a href="https://example.com/gigs/late-gig">Late Gig</a>
                <div class="gig-venue">Venue A</div>
            </div>
        </li>
        
    </ul>
    
</main>
</body>
</html>
